$ Simple test database for never disorder model
$ Based on issue https://github.com/pycalphad/pycalphad/issues/152
$ Minimal Co-Cr system with SIGMA phase that never disorders

 ELEMENT VA   VACUUM                    0.0000E+00  0.0000E+00  0.0000E+00!
 ELEMENT CO   HCP_A3                    5.8933E+01  4.7656E+03  3.0040E+01!
 ELEMENT CR   BCC_A2                    5.1996E+01  4.0500E+03  2.3560E+01!


 FUNCTION GHSERCO   298.15 -3556.47+153.62*T-27.843*T*LN(T)
     +.00541*T**2-1.103E-06*T**3-18860*T**(-1); 1394 Y
      -19235.1+277.375*T-46*T*LN(T)+2.66E+32*T**(-9); 2900 N !
 FUNCTION GHSERCR   298.15 -8856.94+157.48*T-26.908*T*LN(T)
     +.00189435*T**2-1.47721E-06*T**3+139250*T**(-1); 2180 Y
      -34869.344+344.18*T-50*T*LN(T)-2.88526E+32*T**(-9); 6000 N !
 FUNCTION GFCCCO    298.15 +GHSERCO#+427; 6000 N !
 FUNCTION GBCCCO    298.15 +GHSERCO#+3640-1.6*T; 6000 N !
 FUNCTION GBCCCR    298.15 +GHSERCR#; 6000 N !
 FUNCTION GFCCCR    298.15 +GHSERCR#+7284+.163*T; 6000 N !
 FUNCTION GSIGMA    298.15 +8500-2.5*T; 6000 N !
 FUNCTION ZERO      298.15 +0.0; 6000 N !

 TYPE_DEFINITION % SEQ *!
 DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
 DEFAULT_COMMAND DEF_SYS_ELEMENT VA !


$ FCC_A1 phase
 PHASE FCC_A1  %  1 1 !
    CONSTITUENT FCC_A1  :CO,CR :  !

   PARAMETER G(FCC_A1,CO;0)    298.15 +GFCCCO#; 6000 N REF0 !
   PARAMETER G(FCC_A1,CR;0)    298.15 +GFCCCR#; 6000 N REF0 !
   PARAMETER G(FCC_A1,CO,CR;0) 298.15 -9500; 6000 N REF0 !


$ BCC_A2 phase
 PHASE BCC_A2  %  1 1 !
    CONSTITUENT BCC_A2  :CO,CR :  !

   PARAMETER G(BCC_A2,CO;0)    298.15 +GBCCCO#; 6000 N REF0 !
   PARAMETER G(BCC_A2,CR;0)    298.15 +GBCCCR#; 6000 N REF0 !
   PARAMETER G(BCC_A2,CO,CR;0) 298.15 -5000; 6000 N REF0 !


$ SIGMA phase - topologically close packed phase that never disorders
$ Using simplified 2 sublattice model instead of full 5-sublattice model
 TYPE_DEFINITION N GES AMEND_PHASE_DESCRIPTION SIGMA NEVER_DIS !
 PHASE SIGMA  %N  2 10  4 !
    CONSTITUENT SIGMA  :CO,CR : CO,CR :  !

   PARAMETER G(SIGMA,CO:CO;0)    298.15 +14*GFCCCO#+GSIGMA#; 6000 N REF0 !
   PARAMETER G(SIGMA,CO:CR;0)    298.15 +10*GFCCCO#+4*GFCCCR#+GSIGMA#-5000; 6000 N REF0 !
   PARAMETER G(SIGMA,CR:CO;0)    298.15 +10*GFCCCR#+4*GFCCCO#+GSIGMA#-5000; 6000 N REF0 !
   PARAMETER G(SIGMA,CR:CR;0)    298.15 +14*GFCCCR#+GSIGMA#; 6000 N REF0 !
   PARAMETER G(SIGMA,CO,CR:CO;0) 298.15 -2000; 6000 N REF0 !
   PARAMETER G(SIGMA,CO,CR:CR;0) 298.15 -2000; 6000 N REF0 !
   PARAMETER G(SIGMA,CO:CO,CR;0) 298.15 -2000; 6000 N REF0 !
   PARAMETER G(SIGMA,CR:CO,CR;0) 298.15 -2000; 6000 N REF0 !


$ MU phase - another topologically close packed phase that never disorders
$ Using NEVER_DIS keyword with disordered counterpart reference
 TYPE_DEFINITION M GES AMEND_PHASE_DESCRIPTION MU NEVER_DIS DIS_MU,,,!
 PHASE MU  %M  2 7  6 !
    CONSTITUENT MU  :CO,CR : CO,CR :  !

   PARAMETER G(MU,CO:CO;0)    298.15 +13*GBCCCO#+GSIGMA#; 6000 N REF0 !
   PARAMETER G(MU,CO:CR;0)    298.15 +7*GBCCCO#+6*GBCCCR#+GSIGMA#-3000; 6000 N REF0 !
   PARAMETER G(MU,CR:CO;0)    298.15 +7*GBCCCR#+6*GBCCCO#+GSIGMA#-3000; 6000 N REF0 !
   PARAMETER G(MU,CR:CR;0)    298.15 +13*GBCCCR#+GSIGMA#; 6000 N REF0 !
   PARAMETER G(MU,CO,CR:*;0)  298.15 -1500; 6000 N REF0 !
   PARAMETER G(MU,*:CO,CR;0)  298.15 -1500; 6000 N REF0 !


$ Disordered version of MU (for reference, not actually used)
 PHASE DIS_MU  %  1 1 !
    CONSTITUENT DIS_MU  :CO,CR :  !

   PARAMETER G(DIS_MU,CO;0)    298.15 +GBCCCO#; 6000 N REF0 !
   PARAMETER G(DIS_MU,CR;0)    298.15 +GBCCCR#; 6000 N REF0 !
