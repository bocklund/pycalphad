$ Test database for pseudoternary system with compound components
$ System: AB-AC-AD pseudoternary (4 elements: A, B, C, D; 3 components: AB, AC, AD)
ELEMENT A    FCC_A1    10.0      1000.     10.0     !
ELEMENT B    FCC_A1    20.0      2000.     20.0     !
ELEMENT C    FCC_A1    30.0      3000.     30.0     !
ELEMENT D    FCC_A1    40.0      4000.     40.0     !
ELEMENT VA   VACUUM    0.0       0.0       0.0      !

$ Define compound components
SPECIES AB                          A1B1!
SPECIES AC                          A1C1!
SPECIES AD                          A1D1!

FUNCTION GHSERA 298.15 -1000-10*T; 6000 N !
FUNCTION GHSERB 298.15 -2000-20*T; 6000 N !
FUNCTION GHSERC 298.15 -3000-30*T; 6000 N !
FUNCTION GHSERD 298.15 -4000-40*T; 6000 N !

FUNCTION GAB 298.15 +GHSERA+GHSERB-10000+15*T; 6000 N !
FUNCTION GAC 298.15 +GHSERA+GHSERC-12000+18*T; 6000 N !
FUNCTION GAD 298.15 +GHSERA+GHSERD-11000+16*T; 6000 N !

$ Liquid phase - ternary solution of AB, AC, and AD
TYPE_DEFINITION & GES A_P_D LIQUID MAGNETIC  -1.0    0.4 !
PHASE LIQUID:L %& 1 1.0 !
CONSTITUENT LIQUID:L : AB,AC,AD : !
PARAMETER G(LIQUID,AB;0) 298.15 +GAB+5000-10*T; 6000 N !
PARAMETER G(LIQUID,AC;0) 298.15 +GAC+6000-12*T; 6000 N !
PARAMETER G(LIQUID,AD;0) 298.15 +GAD+5500-11*T; 6000 N !
PARAMETER G(LIQUID,AB,AC;0) 298.15 -5000+2*T; 6000 N !
PARAMETER G(LIQUID,AB,AD;0) 298.15 -4500+1.5*T; 6000 N !
PARAMETER G(LIQUID,AC,AD;0) 298.15 -4800+1.8*T; 6000 N !

$ Alpha phase (AB-rich)
PHASE ALPHA % 1 1.0 !
CONSTITUENT ALPHA : AB,AC,AD : !
PARAMETER G(ALPHA,AB;0) 298.15 +GAB; 6000 N !
PARAMETER G(ALPHA,AC;0) 298.15 +GAC+3000; 6000 N !
PARAMETER G(ALPHA,AD;0) 298.15 +GAD+2800; 6000 N !
PARAMETER G(ALPHA,AB,AC;0) 298.15 -3000; 6000 N !
PARAMETER G(ALPHA,AB,AD;0) 298.15 -2800; 6000 N !

$ Beta phase (AC-rich)
PHASE BETA % 1 1.0 !
CONSTITUENT BETA : AB,AC,AD : !
PARAMETER G(BETA,AB;0) 298.15 +GAB+4000; 6000 N !
PARAMETER G(BETA,AC;0) 298.15 +GAC; 6000 N !
PARAMETER G(BETA,AD;0) 298.15 +GAD+3500; 6000 N !
PARAMETER G(BETA,AC,AD;0) 298.15 -3500; 6000 N !

$ Gamma phase (AD-rich)
PHASE GAMMA % 1 1.0 !
CONSTITUENT GAMMA : AB,AC,AD : !
PARAMETER G(GAMMA,AB;0) 298.15 +GAB+3800; 6000 N !
PARAMETER G(GAMMA,AC;0) 298.15 +GAC+3600; 6000 N !
PARAMETER G(GAMMA,AD;0) 298.15 +GAD; 6000 N !
PARAMETER G(GAMMA,AB,AD;0) 298.15 -3200; 6000 N !
